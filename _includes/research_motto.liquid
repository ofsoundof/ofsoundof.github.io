{% comment %}
  Styles for the profile sidebar (address under the photo) and the lab motto,
  which is used on the homepage (profile.more_info) and on the Group page.
{% endcomment %}
<style>
  .profile .more-info {
    font-family: inherit;
    font-size: 0.9rem;
  }
  .profile .more-info p {
    display: block;
    margin: 0;
    color: var(--global-text-color-light);
  }
  .lab-motto {
    margin: 0.9rem 0 0.5rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .lab-motto p,
  .profile .more-info .lab-motto p {
    display: block;
    margin: 0;
    color: #b71c1c;
  }
  html[data-theme='dark'] .lab-motto p,
  html[data-theme='dark'] .profile .more-info .lab-motto p {
    color: #ff7b72;
  }
  .lab-motto-label {
    margin: 1.25rem 0 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--global-text-color-light);
  }
</style>
